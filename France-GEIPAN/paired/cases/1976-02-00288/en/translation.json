          "source_text_sha256": "56720706e03d90c770d24b6a2ff4e5a832b0c0d1755eb6a515a0e5c1c001af3d",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of a moving bright mass: astronomical observations related to a mistake with the Moon.",
